DATABASE_URL=postgres://lexora:lexora@localhost:5432/lexora
HOST=127.0.0.1
PORT=4100
SESSION_TTL_SECONDS=28800
LEXORA_ALLOWED_ORIGIN=https://example.invalid

# Recovery delivery is disabled until production secrets and a verified domain are configured.
RECOVERY_DELIVERY_ENABLED=false
RECOVERY_DELIVERY_PROVIDER=postmark
RECOVERY_APP_ORIGIN=https://app.example.invalid
RECOVERY_FROM_EMAIL=Lexora <no-reply@example.invalid>
RECOVERY_TEMPLATE_ALIAS=lexora-password-recovery
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lexora-web.onrender.com/v1/auth/google/callback
OAUTH_STATE_SECRET=
